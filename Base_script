# --------------------------------------------------
# Main menu
# --------------------------------------------------

main() {
    init_logging
    load_protected_users || true

    section "$SCRIPT_NAME"

    info "Script started."
    info "Log file: $LOG_FILE"

    detect_distribution
    system_information
    audit_users
    audit_and_manage_users
    configure_password_aging
    audit_permissions
    audit_firewall

    section "Optional Security Changes"

    printf 'The following actions can change system configuration.\n'
    printf 'Review competition requirements before approving them.\n'

    if confirm "Review and optionally correct /etc/passwd permissions?"; then
        offer_passwd_permissions_fix
    fi

    if confirm "Review and optionally enable UFW?"; then
        offer_ufw_enable
    fi

    section "Final Summary"

    info "Changes made: $CHANGES_MADE"
    info "Errors encountered: $ERRORS"
    info "Script completed."

    printf 'Changes made: %s\n' "$CHANGES_MADE"
    printf 'Errors encountered: %s\n' "$ERRORS"
    printf 'Log saved to: %s\n' "$LOG_FILE"
}

main "$@"
